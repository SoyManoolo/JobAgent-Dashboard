---
const title = 'JobAgent · Aplicadas';
import '../styles/dashboard.css';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Ofertas aplicadas de JobAgent" />
    <title>{title}</title>
    <script is:inline>
      const savedTheme = localStorage.getItem('jobagent-theme');
      const theme = savedTheme ?? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.dataset.theme = theme;
    </script>
  </head>
  <body>
    <main class="dashboard">
      <header class="topbar">
        <div class="brand"><span class="brand-mark">J</span><span>JobAgent</span></div>
        <div class="topbar-actions">
          <a class="topbar-link" href="/">Ofertas</a>
          <a class="topbar-link" href="/stats/">Estadísticas</a>
          <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Cambiar tema"><span aria-hidden="true">◐</span><span class="theme-toggle-label"></span></button>
          <div class="connection" id="connection-status"><span></span>Cargando ofertas...</div>
        </div>
      </header>

      <section class="intro">
        <div>
          <p class="eyebrow">HISTORIAL</p>
          <h1>Ofertas a las que ya has aplicado.</h1>
          <p class="lede">Consulta y gestiona por separado las candidaturas que ya has enviado.</p>
        </div>
        <div class="total-card"><span>Ofertas aplicadas</span><strong id="total-count">-</strong></div>
      </section>

      <select id="estado" hidden><option value="aplicada" selected>Aplicada</option></select>
      <section class="filters filters-applied" aria-label="Filtros de ofertas aplicadas">
        <label class="search"><span aria-hidden="true">⌕</span><input id="empresa" type="search" placeholder="Buscar por empresa" /></label>
        <label><span>Perfil</span><select id="perfil"><option value="">Todos</option><option value="backend">Backend</option><option value="ia">IA</option><option value="desconocido">Desconocido</option></select></label>
        <label><span>Score mínimo</span><select id="score"><option value="">Cualquiera</option><option value="50">50+</option><option value="60">60+</option><option value="70">70+</option><option value="80">80+</option><option value="90">90+</option></select></label>
        <label><span>Solicitud</span><select id="sencilla"><option value="">Todas</option><option value="true">Sencilla</option><option value="false">Con preguntas</option></select></label>
        <button class="clear" id="clear-filters" type="button">Limpiar filtros</button>
      </section>

      <div class="results-header"><p id="results-count">Cargando...</p><p>Haz clic en una oferta para ver el detalle</p></div>
      <div class="load-state" id="load-state" hidden></div>
      <div class="error-state" id="error-state" hidden><span id="error-message"></span><button id="retry-load" type="button">Reintentar</button></div>
      <section class="jobs" id="jobs" aria-live="polite"></section>
      <p class="empty" id="empty" hidden>No hay ofertas aplicadas que coincidan con los filtros.</p>
      <nav class="pagination" id="pagination" aria-label="Paginación de ofertas" hidden>
        <button id="previous-page" type="button">Anterior</button>
        <span id="page-info"></span>
        <button id="next-page" type="button">Siguiente</button>
      </nav>
    </main>

    <dialog id="detail-modal">
      <article class="modal-content">
        <button class="modal-close" id="modal-close" aria-label="Cerrar detalle" type="button">×</button>
        <div id="modal-body"></div>
      </article>
    </dialog>

    <dialog class="confirm-modal" id="delete-confirm-modal" aria-labelledby="delete-confirm-title">
      <form class="confirm-content" method="dialog">
        <h2 id="delete-confirm-title">¿Eliminar oferta?</h2>
        <p>Esta acción eliminará la oferta.</p>
        <div class="confirm-actions">
          <button type="submit" value="cancel">Cancelar</button>
          <button class="confirm-delete" id="confirm-delete" type="button">Eliminar oferta</button>
        </div>
      </form>
    </dialog>

    <dialog class="confirm-modal" id="discard-confirm-modal" aria-labelledby="discard-confirm-title">
      <form class="confirm-content" method="dialog">
        <h2 id="discard-confirm-title">¿Descartar oferta?</h2>
        <p>La oferta se marcará como descartada y dejará de tener una acción principal.</p>
        <div class="confirm-actions">
          <button type="submit" value="cancel">Cancelar</button>
          <button class="confirm-delete" id="confirm-discard" type="button">Descartar oferta</button>
        </div>
      </form>
    </dialog>

    <template id="job-template">
      <article class="job-card" tabindex="0">
        <div class="job-main">
          <div class="company-row"><span class="company-logo"></span><span class="company"></span></div>
          <h2></h2>
          <p class="location"></p>
          <p class="summary"></p>
          <div class="tags"></div>
        </div>
        <div class="job-side">
          <span class="status"></span>
          <div class="score"><strong></strong><span>score</span></div>
          <div class="card-actions"><button class="apply" type="button">Postularme</button><button class="delete" type="button" aria-label="Eliminar oferta">⌫</button></div>
        </div>
      </article>
    </template>

    <script type="module">
      import { initJobDashboard } from '../scripts/jobDashboard';
      import { initThemeToggle } from '../scripts/theme';

      initThemeToggle();
      initJobDashboard('applied');
    </script>
  </body>
</html>
